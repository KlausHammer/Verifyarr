art": 345.54, "end": 346.54, "text": "Happy housewarming."}, {"start": 346.54, "end": 348.34, "text": "Oh."}, {"start": 348.34, "end": 349.74, "text": "Cool."}, {"start": 349.74, "end": 351.92, "text": "Thanks, Piers."}, {"start": 351.92, "end": 353.34, "text": "Whoa!"}, {"start": 353.34, "end": 354.24, "text": "What is it?"}, {"start": 354.24, "end": 357.16, "text": "Look, it's a traditional Norwegian troll."}, {"start": 357.16, "end": 358.42, "text": "When Troy and I were living together,"}, {"start": 358.42, "end": 362.42, "text": "I had it on display in the hall, you know, outside his bedroom."}, {"start": 362.42, "end": 365.46, "text": "He seemed very taken with it."}, {"start": 365.46, "end": 366.96, "text": "He used to watch me sleep."}, {"start": 366.96, "end": 368.54, "text": "Piers, shame on you."}, {"start": 368.54, "end": 370.0, "text": "Jeff, what are you going to do about this?"}, {"start": 370.0, "end": 371.46, "text": "I'm going to get a drink."}, {"start": 371.46, "end": 372.36, "text": "Ow."}, {"start": 372.36, "end": 373.26, "text": "Oh, my god."}, {"start": 373.26, "end": 374.16, "text": "Are you OK?"}, {"start": 374.16, "end": 375.06, "text": "I barely felt it."}, {"start": 375.06, "end": 376.36, "text": "- Let me look at it in the bathroom."}, {"start": 376.36, "end": 377.78, "text": "It's not dignified."}, {"start": 378.84, "end": 380.14, "text": "- Pizza!"}, {"start": 380.14, "end": 382.22, "text": "Pizza, pizza, in my tummy."}, {"start": 382.22, "end": 384.78, "text": "Me so hungy, me so hungy."}, {"start": 384.78, "end": 386.86, "text": "- Did someone remember to take out my pipe?"}, {"start": 388.38, "end": 389.78, "text": "Seriously?"}, {"start": 389.78, "end": 390.62, "text": "- Oh!"}, {"start": 391.86, "end": 393.48, "text": "Oh!"}, {"start": 393.48, "end": 394.32, "text": "Oh no!"}, {"start": 396.54, "end": 397.7, "text": "Seriously?"}, {"start": 397.7, "end": 399.42, "text": "- Shirley, it doesn't matter."}, {"start": 399.42, "end": 4