# Runtime data — database, backups, quarantine, reports, logs. Never commit real user data.
/data/

# Python
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Built frontend copied into the backend for the Docker image
verifyarr/web/static/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# SQLite artifacts (stray/local test DBs)
*.db
*.db-shm
*.db-wal

# Editor/OS cruft
.DS_Store
.vscode/
.idea/

# The test matrix's working files: corrupted subtitle copies, shard logs and
# shard results. Only the merged results and tests/data/ belong in the repo.
tests/e2e_work_*/
tests/e2e_work_*.log
tests/e2e_matrix_[0-9]*.jsonl
tests/e2e_matrix_summary_[0-9]*.json
tests/e2e_valid_*[0-9].jsonl

# Known Good dataset runs (work files; the merged results live in tests/known_good/results/)
tests/kg_*_[0-9]*.jsonl
tests/kg_*_summary_[0-9]*.json
tests/kg_*.jsonl
tests/kg_*_summary.json
tests/known_good/data/alass/*.part*
